{
  "name": "aithos/agentenblick",
  "description": "Server-side AI traffic measurement for Shopware",
  "type": "shopware-platform-plugin",
  "version": "0.1.0",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-sodium": "*",
    "ext-openssl": "*",
    "shopware/core": "~6.6.0 || ~6.7.0",
    "bakame/http-structured-fields": "^2.0",
    "phpseclib/phpseclib": "^3.0"
  },
  "autoload": {"psr-4": {"Aithos\\Agentenblick\\": "src/"}},
  "autoload-dev": {"psr-4": {"Aithos\\Agentenblick\\Tests\\": "tests/"}},
  "extra": {
    "shopware-plugin-class": "Aithos\\Agentenblick\\AithosAgentenblick",
    "label": {"de-DE": "Agentenblick", "en-GB": "Agentenblick"}
  }
}
