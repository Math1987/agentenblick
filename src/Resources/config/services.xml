<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autowire="true" autoconfigure="true" public="false"/>
        <service id="Aithos\Agentenblick\Benchmark\SecretVault">
            <argument key="$kernelSecret">%kernel.secret%</argument>
        </service>
        <service id="Aithos\Agentenblick\Benchmark\State">
            <argument key="$environment">%kernel.environment%</argument>
        </service>
        <service id="Aithos\Agentenblick\Benchmark\Drafts">
            <argument key="$shopwareVersion">%kernel.shopware_version%</argument>
        </service>
        <service id="Aithos\Agentenblick\Benchmark\Transport" autowire="false"/>
        <service id="Aithos\Agentenblick\Benchmark\Manager" public="true"/>
        <service id="Aithos\Agentenblick\Controller\BenchmarkController" public="true">
            <tag name="controller.service_arguments"/>
        </service>
        <service id="Aithos\Agentenblick\Command\BenchmarkCommand"/>
        <service id="Aithos\Agentenblick\ScheduledTask\BenchmarkTask"><tag name="shopware.scheduled.task"/></service>
        <service id="Aithos\Agentenblick\ScheduledTask\BenchmarkTaskHandler">
            <argument key="$scheduledTaskRepository" type="service" id="scheduled_task.repository"/>
        </service>
        <service id="Aithos\Agentenblick\Admin\AnalyticsReader"/>
        <service id="Aithos\Agentenblick\Admin\RangeApprovals"/>
        <service id="Aithos\Agentenblick\Admin\AclPrivilegesSubscriber"/>
        <service id="Aithos\Agentenblick\Controller\AnalyticsController" public="true">
            <tag name="controller.service_arguments"/>
        </service>
        <service id="Aithos\Agentenblick\Persistence\DailyKey"/>
        <service id="Aithos\Agentenblick\Persistence\ObservationStore"/>
        <service id="Aithos\Agentenblick\Persistence\ProxyDiagnostics"/>
        <service id="Aithos\Agentenblick\Persistence\Purger"/>
        <service id="Aithos\Agentenblick\Verification\ReverseDns"/>
        <service id="Aithos\Agentenblick\Verification\RangeRefresher"/>
        <service id="Aithos\Agentenblick\Verification\Classifier"/>
        <service id="Aithos\Agentenblick\Verification\PendingSignatures"/>
        <service id="Aithos\Agentenblick\Verification\KeyDirectory">
            <argument key="$environment">%kernel.environment%</argument>
        </service>
        <service id="Aithos\Agentenblick\Capture\FailureCounter">
            <argument key="$projectDir">%kernel.project_dir%</argument>
        </service>
        <service id="Aithos\Agentenblick\Verification\CatalogueProvider">
            <argument key="$environment">%kernel.environment%</argument>
        </service>
        <service id="Aithos\Agentenblick\Capture\ObservationSubscriber"/>
        <service id="Aithos\Agentenblick\Capture\SalesChannelResolver"/>
        <service id="Aithos\Agentenblick\Command\ReportCommand"/>
        <service id="Aithos\Agentenblick\Command\PurgeCommand"/>
        <service id="Aithos\Agentenblick\Command\RefreshRangesCommand"/>
        <service id="Aithos\Agentenblick\Command\VerifyRequestCommand"/>
        <service id="Aithos\Agentenblick\Command\ReverifyCommand"/>
        <service id="Aithos\Agentenblick\Command\SelfTestCommand">
            <argument key="$debug">%kernel.debug%</argument>
            <argument key="$projectDir">%kernel.project_dir%</argument>
        </service>
        <service id="Aithos\Agentenblick\ScheduledTask\RefreshRangesTask"><tag name="shopware.scheduled.task"/></service>
        <service id="Aithos\Agentenblick\ScheduledTask\PurgeTask"><tag name="shopware.scheduled.task"/></service>
        <service id="Aithos\Agentenblick\ScheduledTask\ReverifyTask"><tag name="shopware.scheduled.task"/></service>
        <service id="Aithos\Agentenblick\ScheduledTask\ReverifyTaskHandler">
            <argument key="$scheduledTaskRepository" type="service" id="scheduled_task.repository"/>
        </service>
        <service id="Aithos\Agentenblick\ScheduledTask\RefreshRangesTaskHandler">
            <argument key="$scheduledTaskRepository" type="service" id="scheduled_task.repository"/>
        </service>
        <service id="Aithos\Agentenblick\ScheduledTask\PurgeTaskHandler">
            <argument key="$scheduledTaskRepository" type="service" id="scheduled_task.repository"/>
        </service>
        <service id="Aithos\Agentenblick\Capture\ObservedKernel" decorates="http_kernel" decoration-priority="-100">
            <argument key="$inner" type="service" id="Aithos\Agentenblick\Capture\ObservedKernel.inner"/>
        </service>
    </services>
</container>
