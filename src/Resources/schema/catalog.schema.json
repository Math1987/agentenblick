{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentenblick:catalogue:1",
  "title": "Agentenblick operator catalogue, version 1",
  "description": "Static catalogue shape. testOnly documents may only be loaded when the application environment is test; JSON Schema cannot check the runtime environment. Public CIDRs, PCRE validity, directory trust and JWK cryptography require runtime validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "testOnly", "robotsOnlyTokens", "agents", "cdnRanges"],
  "properties": {
    "schema": {"const": "agentenblick.catalogue/1"},
    "testOnly": {"type": "boolean", "description": "True permits isolated local fixtures and must be refused outside the test environment."},
    "robotsOnlyTokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}, "description": "Robots policy tokens that must never be mistaken for observed user-agent identities."},
    "agents": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/agent"}},
    "cdnRanges": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/cdn"}}
  },
  "allOf": [
    {
      "if": {"properties": {"testOnly": {"const": false}}},
      "then": {
        "properties": {
          "agents": {
            "items": {
              "properties": {
                "origin": {"$ref": "#/$defs/httpsUri"},
                "directory": {"$ref": "#/$defs/httpsUri"},
                "rangesUrl": {"anyOf": [{"$ref": "#/$defs/httpsUri"}, {"type": "null"}]},
                "source": {"$ref": "#/$defs/httpsUri"}
              }
            }
          },
          "cdnRanges": {"items": {"properties": {"source": {"$ref": "#/$defs/httpsUri"}}}}
        }
      }
    }
  ],
  "$defs": {
    "kind": {"enum": ["training_crawler", "search_crawler", "user_fetch", "browsing_agent", "automation_unknown", "human_or_unknown"]},
    "httpsUri": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
    "httpUri": {"type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2048},
    "ranges": {
      "type": "array",
      "maxItems": 50000,
      "uniqueItems": true,
      "items": {"type": "string", "format": "cidr", "maxLength": 50, "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"},
      "description": "CIDR notation. The custom cidr format must check address and prefix validity. Local ranges are fixtures only, never evidence for a real operator."
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operator", "pattern", "kind", "ranges", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 100},
        "operator": {"type": "string", "minLength": 1, "maxLength": 64},
        "pattern": {"type": "string", "minLength": 1, "maxLength": 2048, "description": "PHP PCRE pattern including delimiters; it identifies a declaration, not proof."},
        "robotsToken": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "kind": {"$ref": "#/$defs/kind"},
        "verification": {"enum": ["declaration_only", "ip", "signature"]},
        "ranges": {"$ref": "#/$defs/ranges"},
        "rangesUrl": {"anyOf": [{"$ref": "#/$defs/httpUri"}, {"type": "null"}]},
        "rangesRetrievedAt": {"type": "string", "format": "date-time"},
        "origin": {"$ref": "#/$defs/httpUri"},
        "directory": {"$ref": "#/$defs/httpUri"},
        "source": {"type": "string", "minLength": 1, "maxLength": 2048},
        "rdnsSuffixes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.[a-z0-9]+(?:[a-z0-9.-]*[a-z0-9])$", "maxLength": 253}},
        "keys": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/publicJwk"}}
      },
      "dependentRequired": {"origin": ["directory"], "directory": ["origin"], "keys": ["origin", "directory"]}
    },
    "cdn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "source", "ranges"],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 100},
        "source": {"type": "string", "minLength": 1, "maxLength": 2048},
        "ranges": {"$ref": "#/$defs/ranges"}
      }
    },
    "publicJwk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kty"],
      "properties": {
        "kty": {"enum": ["OKP", "RSA"]},
        "crv": {"const": "Ed25519"},
        "x": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
        "n": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 1400},
        "e": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 16},
        "kid": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$", "description": "The RFC 7638/8037 SHA-256 JWK thumbprint, not an arbitrary label."},
        "alg": {"enum": ["EdDSA", "Ed25519", "PS512"]},
        "use": {"const": "sig"},
        "key_ops": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "verify"}}
      },
      "allOf": [
        {"if": {"properties": {"kty": {"const": "OKP"}}}, "then": {"required": ["crv", "x"], "properties": {"alg": {"enum": ["EdDSA", "Ed25519"]}, "n": false, "e": false}}},
        {"if": {"properties": {"kty": {"const": "RSA"}}}, "then": {"required": ["n", "e"], "properties": {"alg": {"const": "PS512"}, "crv": false, "x": false}}}
      ]
    }
  }
}
